# Entorno general
PROJECT_NAME=PULSE API
VERSION=0.1.0
API_V1_STR=/api/v1
ENVIRONMENT=development

# ──────────────────────────────────────────────────────────
# Base de datos — Supabase PostgreSQL
# ──────────────────────────────────────────────────────────
# Opción 1: Supabase Session Pooler (puerto 5432)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Opción 2: SQLite local para desarrollo sin Supabase
# DATABASE_URL=sqlite+aiosqlite:///./sogr.db

# Pool de conexiones (solo aplica para PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_SSL_REQUIRED=true

# ──────────────────────────────────────────────────────────
# Seguridad y JWT
# ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ──────────────────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ──────────────────────────────────────────────────────────
# Inteligencia Artificial y Reconocimiento de Voz
# ──────────────────────────────────────────────────────────
# ElevenLabs API Key para Reconocimiento y Transcripción de Audio de Operadores de Campo (Speech-to-Text)
ELEVENLABS_API_KEY=tu_key_aqui
# Anthropic Claude API Key para Análisis y Diagnóstico de Incidentes (LLM - Claude 3.5 Sonnet / Claude 3.7 Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_API_KEY=your_anthropic_api_key_here
